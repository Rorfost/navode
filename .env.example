# Public web configuration
VITE_API_BASE_URL=

# API / Cloudflare configuration
APP_ENV=development
APP_VERSION=1.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Direct PostgreSQL access is for an authorized migration runner only. Do not set
# this in Cloudflare Worker variables or client environment files.
DATABASE_URL=

# Server-only Better Auth configuration. Set AUTH_SECRET through Wrangler/GitHub
# secrets for production; never place it in client build variables.
AUTH_BASE_URL=http://localhost:8787
AUTH_SECRET=
