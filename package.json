{
  "name": "navode",
  "version": "0.1.0",
  "private": true,
  "description": "A personal browser command center.",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @navode/web dev",
    "dev:extension": "pnpm --filter @navode/extension dev",
    "dev:api": "pnpm --filter @navode/api dev",
    "build": "pnpm -r --if-present build",
    "build:web": "pnpm --filter @navode/web build",
    "build:extension": "pnpm --filter @navode/extension build && node scripts/check-extension.mjs",
    "build:api": "pnpm --filter @navode/api build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @navode/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
