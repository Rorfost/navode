{
  "name": "@navode/api",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node scripts/run-drizzle-kit.cjs generate",
    "db:check": "node scripts/run-drizzle-kit.cjs check",
    "db:migrate": "node scripts/run-drizzle-kit.cjs migrate",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@navode/config": "workspace:*",
    "better-auth": "1.7.5",
    "drizzle-orm": "^0.45.2",
    "hono": "4.8.3",
    "postgres": "^3.4.9",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "@electric-sql/pglite": "^0.5.13",
    "drizzle-kit": "^0.31.11",
    "vitest": "5.0.5",
    "wrangler": "4.155.0"
  }
}
